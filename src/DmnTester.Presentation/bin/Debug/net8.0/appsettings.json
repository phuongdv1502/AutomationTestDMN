{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DmnConfigPath": "config",
  "DmnFilesPath": "dmn",
  "TimeoutSettings": {
    "RequestTimeout": 120000,
    "DmnEvaluationTimeout": 30000,
    "BatchTestTimeout": 300000,
    "FileReadTimeout": 10000
  },
  "PerformanceSettings": {
    "MaxFileSizeMB": 100,
    "MaxRulesPerDecision": 2000,
    "MaxTotalRules": 15000,
    "ChunkSizeKB": 512,
    "EnableCaching": true,
    "CacheTimeoutMinutes": 30
  }
} 